<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".bai2.MainActivity"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:background="#00BCD4"
            android:text="Cộng sau khi delay 1s"/>
        <TextView
            android:id="@+id/tvAdd"
            android:layout_weight="1"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:textColor="#E91E63"
            android:textSize="24sp"
            android:text="0"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:background="#00BCD4"
            android:text="Trừ sau khi delay 1s"/>
        <TextView
            android:id="@+id/tvDeduct"
            android:layout_weight="1"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:textColor="#E91E63"
            android:textSize="24sp"
            android:text="0"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:background="#00BCD4"
            android:text="Nhân 2 sau khi delay 5s"/>
        <TextView
            android:id="@+id/tvMultiplication"
            android:layout_weight="1"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:textColor="#E91E63"
            android:textSize="24sp"
            android:text="0"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:background="#00BCD4"
            android:text="Random số ngẫu nhiên mỗi 3s"/>
        <TextView
            android:id="@+id/tvRandom"
            android:layout_weight="1"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:textColor="#E91E63"
            android:textSize="24sp"
            android:text="0"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnStopAdd"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:text="Dừng cộng"/>
        <Button
            android:id="@+id/btnReadd"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Chạy lại cộng"/>
        <Button
            android:id="@+id/btnStopDeduct"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:text="Dừng trừ"/>
        <Button
            android:id="@+id/btnRededuct"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_marginStart="16dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Chay lại trừ"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <Button
            android:id="@+id/btnStopMultiplication"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:visibility="visible"
            android:layout_height="wrap_content"
            android:text="Dừng nhân"/>
        <Button
            android:id="@+id/btnRemultiplication"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Chạy lại nhân"/>
        <Button
            android:id="@+id/btnStopRandom"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Dừng random"/>
        <Button
            android:id="@+id/btnRandom"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Chạy lại random"/>
    </LinearLayout>
</LinearLayout>